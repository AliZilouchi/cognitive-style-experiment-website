# Browser-safe public configuration. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only values. These are used by the same-origin Next.js proxy and are
# never included in browser JavaScript.
RAG_API_URL=http://127.0.0.1:8000
RAG_API_TOKEN=REPLACE_WITH_THE_SAME_LONG_RANDOM_VALUE_AS_BACKEND_API_SHARED_SECRET
