# Hosted OpenRouter embedding evaluation; no local model download is required.
APP_ENV=evaluation

EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Study freeze label. OpenRouter does not expose an immutable model commit hash.
EMBEDDING_REVISION=openrouter-catalog-2026-08-25
EMBEDDING_DIMENSION=1024
QUERY_PREFIX=query:
DOCUMENT_PREFIX=passage:
TOP_K=5

LLM_PROVIDER=echo
LLM_MODEL=development-only
LLM_MAX_TOKENS=700

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_API_KEY
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Cognitive Style Experiment

TOGETHER_API_KEY=
GROQ_API_KEY=
INDEX_DIR=data/index
ENABLE_DEBUG_RETRIEVAL=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
