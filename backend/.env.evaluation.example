# Hosted Together evaluation without downloading an embedding model locally.
APP_ENV=evaluation
EMBEDDING_PROVIDER=together
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
# Together does not expose a Hugging Face commit hash. This is the study's
# provider-catalog freeze label and is included in every logged model identity.
EMBEDDING_REVISION=together-serverless-catalog-2026-08-25
EMBEDDING_DIMENSION=1024
QUERY_PREFIX="Instruct: Given a Persian search query, retrieve relevant Persian passages that answer the query\nQuery: "
DOCUMENT_PREFIX=
TOP_K=5

LLM_PROVIDER=echo
LLM_MODEL=development-only
LLM_MAX_TOKENS=700
TOGETHER_API_KEY=REPLACE_WITH_YOUR_TOGETHER_API_KEY
GROQ_API_KEY=

INDEX_DIR=data/index
ENABLE_DEBUG_RETRIEVAL=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
