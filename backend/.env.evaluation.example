# Hosted AvalAI embedding evaluation; no local model download is required.
APP_ENV=evaluation

EMBEDDING_PROVIDER=avalai
EMBEDDING_MODEL=text-embedding-3-large
# Study freeze label; this is not a provider commit hash.
EMBEDDING_REVISION=avalai-2026-09-04
EMBEDDING_DIMENSION=1024
QUERY_PREFIX=
DOCUMENT_PREFIX=
TOP_K=3
RETRIEVAL_SCORE_MARGIN=0.12
MAX_CHUNKS_PER_SOURCE=2
MMR_LAMBDA=0.75

LLM_PROVIDER=echo
LLM_MODEL=development-only
LLM_MAX_TOKENS=700
RESOLVER_MODEL=
RESOLVER_MAX_TOKENS=250
RESOLVER_TIMEOUT_SECONDS=8

AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_API_KEY=REPLACE_WITH_YOUR_AVALAI_API_KEY

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Cognitive Style Experiment

TOGETHER_API_KEY=
GROQ_API_KEY=
INDEX_DIR=data/index
ENABLE_DEBUG_RETRIEVAL=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
