# Exact hosted production configuration for Vercel.
APP_ENV=experiment

# Hosted embedding API; no local model or GPU is required.
EMBEDDING_PROVIDER=together
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
EMBEDDING_REVISION=together-serverless-catalog-2026-08-25
EMBEDDING_DIMENSION=1024
QUERY_PREFIX="Instruct: Given a Persian search query, retrieve relevant Persian passages that answer the query\nQuery: "
DOCUMENT_PREFIX=
TOP_K=5

# Groq remains the generation provider.
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.6-27b
LLM_MAX_TOKENS=700
TOGETHER_API_KEY=REPLACE_WITH_YOUR_TOGETHER_API_KEY
GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_API_KEY
API_SHARED_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

INDEX_DIR=/tmp/sepid-index
ENABLE_DEBUG_RETRIEVAL=false
ALLOWED_ORIGINS=REPLACE_WITH_EXPERIMENT_FRONTEND_ORIGIN
