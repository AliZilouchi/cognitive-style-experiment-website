# Exact OpenRouter production configuration for the Vercel backend.
APP_ENV=experiment

EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_REVISION=openrouter-catalog-2026-08-25
EMBEDDING_DIMENSION=1024
QUERY_PREFIX=query:
DOCUMENT_PREFIX=passage:
TOP_K=5

LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
LLM_MAX_TOKENS=700

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_API_KEY
OPENROUTER_HTTP_REFERER=REPLACE_WITH_YOUR_FRONTEND_HTTPS_ORIGIN
OPENROUTER_APP_TITLE=Cognitive Style Experiment

API_SHARED_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
INDEX_DIR=/tmp/sepid-index
ENABLE_DEBUG_RETRIEVAL=false
ALLOWED_ORIGINS=REPLACE_WITH_YOUR_FRONTEND_HTTPS_ORIGIN

# Unused provider keys may stay empty.
TOGETHER_API_KEY=
GROQ_API_KEY=
