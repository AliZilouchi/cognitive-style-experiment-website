# Exact AvalAI production configuration for the Vercel backend.
APP_ENV=experiment

EMBEDDING_PROVIDER=avalai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_REVISION=avalai-2026-09-04
EMBEDDING_DIMENSION=1024
QUERY_PREFIX=
DOCUMENT_PREFIX=
TOP_K=3
RETRIEVAL_SCORE_MARGIN=0.12
MAX_CHUNKS_PER_SOURCE=2
MMR_LAMBDA=0.75

LLM_PROVIDER=avalai
LLM_MODEL=gpt-4.1-mini-2025-04-14
LLM_MAX_TOKENS=700

AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_API_KEY=REPLACE_WITH_YOUR_AVALAI_API_KEY

API_SHARED_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
INDEX_DIR=/tmp/sepid-index
ENABLE_DEBUG_RETRIEVAL=false
ALLOWED_ORIGINS=REPLACE_WITH_YOUR_FRONTEND_HTTPS_ORIGIN

# Unused provider keys may stay empty.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Cognitive Style Experiment
TOGETHER_API_KEY=
GROQ_API_KEY=
