# Copy this file to .env and replace only the secret/API and origin values.
APP_ENV=experiment

# Frozen retrieval configuration selected after Persian retrieval evaluation.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
EMBEDDING_REVISION=274baa43b0e13e37fafa6428dbc7938e62e5c439
EMBEDDING_DIMENSION=1024
QUERY_PREFIX="Instruct: Given a Persian search query, retrieve relevant Persian passages that answer the query\nQuery: "
DOCUMENT_PREFIX=
TOP_K=3
RETRIEVAL_SCORE_MARGIN=0.12
MAX_CHUNKS_PER_SOURCE=2
MMR_LAMBDA=0.75

# Frozen generation configuration tested in Colab.
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.6-27b
LLM_MAX_TOKENS=700
GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_API_KEY
TOGETHER_API_KEY=

# Must match RAG_API_TOKEN in the Next.js/Vercel environment. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SHARED_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional Hugging Face token: useful for higher download rate limits.
HF_TOKEN=

CORPUS_ROOT=/app/corpus
INDEX_DIR=/app/data/index
ENABLE_DEBUG_RETRIEVAL=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
INSTALL_LOCAL_EMBEDDINGS=true
